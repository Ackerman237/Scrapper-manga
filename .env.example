# Example environment variables for doujin-scraper
# Copy to .env and fill values when deploying locally or to server

# Server
PORT=3000

# Optional: proxy to use for nekopoi scraping (socks5:// or http://proxy:port)
NEKO_PROXY_URL=

# Optional: app secrets used by doujin API decryption logic
DOUJIN_APP_SECRET=
DOUJIN_SALT=

# Comma-separated list of allowed image hostnames for the image proxy endpoint
# Example: doujin.desu.xxx,cdn.doujin.desu.xxx
ALLOWED_IMAGE_HOSTS=doujin.desu.xxx,cdn.doujin.desu.xxx

# Optional: enable CORS for a specific origin (leave empty to allow any origin for dev)
CORS_ORIGIN=
